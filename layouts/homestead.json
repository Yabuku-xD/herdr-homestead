{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [12, 16],
  "preview": "layouts/homestead.png",
  "background": "chrome",
  "terminal_padding": [14, 12],
  "resizable": false,
  "children": [
    {
      "id": "fit-y",
      "type": "block",
      "size": { "px": 0 },
      "content": { "mod": "homestead", "props": { "role": "fit", "axis": "y" } }
    },
    {
      "id": "shell",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "fit-x",
          "type": "block",
          "size": { "px": 0 },
          "content": { "mod": "homestead", "props": { "role": "fit", "axis": "x" } }
        },
        {
          "id": "frame",
          "type": "row",
          "divider": { "width": 1, "color": "border" },
          "children": [
            {
              "id": "sidebar",
              "type": "column",
              "size": { "px": 268 },
              "min": 44,
              "max": 480,
              "background": "chrome",
              "resizable": false,
              "children": [
                {
                  "id": "brand",
                  "type": "block",
                  "size": { "px": 46 },
                  "window_drag": true,
                  "content": { "mod": "workspace-chrome" }
                },
                {
                  "id": "inbox",
                  "type": "block",
                  "hidden": true,
                  "size": { "px": 96 },
                  "content": { "mod": "homestead", "props": { "role": "inbox" } }
                },
                {
                  "id": "sidebar-lists",
                  "type": "column",
                  "children": [
                    {
                      "id": "spaces",
                      "type": "block",
                      "size": { "weight": 2 },
                      "min": 90,
                      "content": { "mod": "spaces" }
                    },
                    {
                      "id": "agents",
                      "type": "block",
                      "size": { "weight": 3 },
                      "min": 90,
                      "content": { "mod": "agents" }
                    }
                  ]
                },
                {
                  "id": "rail",
                  "type": "block",
                  "hidden": true,
                  "content": { "mod": "homestead", "props": { "role": "rail" } }
                },
                {
                  "id": "sidebar-footer",
                  "type": "block",
                  "size": { "px": 69 },
                  "content": { "mod": "workspace-chrome", "props": { "footer": true } }
                }
              ]
            },
            {
              "id": "work",
              "type": "column",
              "resizable": false,
              "children": [
                {
                  "id": "topbar",
                  "type": "row",
                  "size": { "px": 42 },
                  "resizable": false,
                  "children": [
                    {
                      "id": "tabs",
                      "type": "block",
                      "window_drag": true,
                      "content": { "mod": "tabs" }
                    },
                    {
                      "id": "bar",
                      "type": "block",
                      "size": { "px": 116 },
                      "window_drag": true,
                      "content": { "mod": "homestead", "props": { "role": "bar" } }
                    }
                  ]
                },
                {
                  "id": "work-body",
                  "type": "row",
                  "padding": 8,
                  "gap": 8,
                  "children": [
                    {
                      "id": "view",
                      "type": "stack",
                      "active": "main",
                      "children": [
                        {
                          "id": "main",
                          "type": "block",
                          "content": {
                            "tab": "active",
                            "pane": {
                              "gap": 8,
                              "radius": 10,
                              "background": "background",
                              "lone": true,
                              "border": { "width": 1, "color": "border" },
                              "focus": { "width": 1, "color": "accent" },
                              "header": {
                                "content": { "mod": "pane" },
                                "height": 30,
                                "position": "top",
                                "reveal": "always"
                              }
                            }
                          }
                        },
                        {
                          "id": "agent",
                          "type": "column",
                          "radius": 10,
                          "background": "background",
                          "border": { "width": 1, "color": "border" },
                          "focus": { "border": { "width": 1, "color": "accent" } },
                          "resizable": false,
                          "children": [
                            {
                              "id": "agent-head",
                              "type": "block",
                              "size": { "px": 30 },
                              "content": { "mod": "homestead", "props": { "role": "agent-head" } }
                            },
                            { "id": "agent-terminal", "type": "block", "content": { "agent": "focused" } }
                          ]
                        },
                        {
                          "id": "fleet",
                          "type": "block",
                          "radius": 10,
                          "background": "background",
                          "border": { "width": 1, "color": "border" },
                          "content": { "mod": "homestead", "props": { "role": "fleet" } }
                        }
                      ]
                    },
                    {
                      "id": "panel",
                      "type": "column",
                      "hidden": true,
                      "size": { "px": 368 },
                      "min": 280,
                      "max": 900,
                      "children": [
                        {
                          "id": "panel-body",
                          "type": "stack",
                          "active": "files",
                          "children": [
                            { "id": "files", "type": "block", "content": { "mod": "files" } },
                            { "id": "changes", "type": "block", "content": { "mod": "changes" } },
                            {
                              "id": "github",
                              "type": "block",
                              "content": {
                                "mod": "homestead",
                                "props": {
                                  "role": "github",
                                  "panel": { "label": "GitHub", "icon": "mods/homestead/github.svg" }
                                }
                              }
                            }
                          ]
                        },
                        {
                          "id": "panel-spare",
                          "type": "block",
                          "size": { "px": 0 },
                          "content": { "mod": "homestead", "props": { "role": "blank" } }
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "status",
                  "type": "block",
                  "size": { "px": 28 },
                  "content": { "mod": "homestead", "props": { "role": "status" } }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
