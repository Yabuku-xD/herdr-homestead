{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "preview": "layouts/Homestead.png",
  "background": "chrome",
  "terminal_padding": [
    14,
    12
  ],
  "resizable": false,
  "children": [
    {
      "id": "fit-y",
      "type": "block",
      "size": {
        "px": 0
      },
      "content": {
        "mod": "homestead",
        "props": {
          "role": "fit",
          "axis": "y"
        }
      }
    },
    {
      "id": "shell",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "fit-x",
          "type": "block",
          "size": {
            "px": 0
          },
          "content": {
            "mod": "homestead",
            "props": {
              "role": "fit",
              "axis": "x"
            }
          }
        },
        {
          "id": "frame",
          "type": "row",
          "divider": {
            "width": 1,
            "color": "chrome"
          },
          "children": [
            {
              "id": "sidebar",
              "type": "column",
              "size": {
                "px": 268
              },
              "min": 44,
              "max": 480,
              "background": "chrome",
              "resizable": false,
              "children": [
                {
                  "id": "brand",
                  "type": "block",
                  "size": {
                    "px": 46
                  },
                  "window_drag": true,
                  "content": {
                    "mod": "workspace-chrome"
                  }
                },
                {
                  "id": "sidebar-lists",
                  "type": "column",
                  "children": [
                    {
                      "id": "spaces",
                      "type": "block",
                      "size": {
                        "weight": 2
                      },
                      "min": 90,
                      "content": {
                        "mod": "spaces"
                      }
                    },
                    {
                      "id": "inbox",
                      "type": "block",
                      "hidden": true,
                      "size": {
                        "px": 96
                      },
                      "content": {
                        "mod": "homestead",
                        "props": {
                          "role": "inbox"
                        }
                      }
                    },
                    {
                      "id": "agents",
                      "type": "block",
                      "size": {
                        "weight": 3
                      },
                      "min": 90,
                      "content": {
                        "mod": "agents"
                      }
                    }
                  ]
                },
                {
                  "id": "rail",
                  "type": "block",
                  "hidden": true,
                  "content": {
                    "mod": "homestead",
                    "props": {
                      "role": "rail"
                    }
                  }
                },
                {
                  "id": "sidebar-footer",
                  "type": "block",
                  "size": {
                    "px": 69
                  },
                  "content": {
                    "mod": "workspace-chrome",
                    "props": {
                      "footer": true
                    }
                  }
                }
              ]
            },
            {
              "id": "work",
              "type": "column",
              "resizable": false,
              "children": [
                {
                  "id": "topbar",
                  "type": "row",
                  "size": {
                    "px": 42
                  },
                  "resizable": false,
                  "children": [
                    {
                      "id": "tabs",
                      "type": "block",
                      "window_drag": true,
                      "content": {
                        "mod": "tabs"
                      }
                    },
                    {
                      "id": "bar",
                      "type": "block",
                      "size": {
                        "px": 116
                      },
                      "window_drag": true,
                      "content": {
                        "mod": "homestead",
                        "props": {
                          "role": "bar"
                        }
                      }
                    }
                  ]
                },
                {
                  "id": "work-body",
                  "type": "row",
                  "padding": 8,
                  "gap": 8,
                  "children": [
                    {
                      "id": "view",
                      "type": "stack",
                      "active": "main",
                      "children": [
                        {
                          "id": "main",
                          "type": "block",
                          "content": {
                            "tab": "active",
                            "pane": {
                              "gap": 8,
                              "radius": 10,
                              "background": "background",
                              "lone": true,
                              "border": {
                                "width": 1,
                                "color": "border"
                              },
                              "focus": {
                                "width": 1,
                                "color": "border"
                              },
                              "header": {
                                "content": {
                                  "mod": "homestead",
                                  "props": {
                                    "role": "pane"
                                  }
                                },
                                "height": 30,
                                "position": "top",
                                "reveal": "always"
                              }
                            }
                          }
                        },
                        {
                          "id": "agent",
                          "type": "column",
                          "radius": 10,
                          "background": "background",
                          "border": {
                            "width": 1,
                            "color": "border"
                          },
                          "resizable": false,
                          "children": [
                            {
                              "id": "agent-head",
                              "type": "block",
                              "size": {
                                "px": 30
                              },
                              "content": {
                                "mod": "homestead",
                                "props": {
                                  "role": "agent-head"
                                }
                              }
                            },
                            {
                              "id": "agent-terminal",
                              "type": "block",
                              "content": {
                                "agent": "focused"
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "id": "panel",
                      "type": "column",
                      "hidden": true,
                      "size": {
                        "px": 368
                      },
                      "min": 280,
                      "max": 900,
                      "children": [
                        {
                          "id": "panel-body",
                          "type": "stack",
                          "active": "files",
                          "children": [
                            {
                              "id": "files",
                              "type": "block",
                              "content": {
                                "mod": "files"
                              }
                            },
                            {
                              "id": "changes",
                              "type": "block",
                              "content": {
                                "mod": "changes"
                              }
                            },
                            {
                              "id": "github",
                              "type": "block",
                              "content": {
                                "mod": "homestead",
                                "props": {
                                  "role": "github",
                                  "panel": {
                                    "label": "GitHub",
                                    "icon": "github",
                                    "badge": "homestead.github.attention"
                                  }
                                }
                              }
                            }
                          ]
                        },
                        {
                          "id": "panel-spare",
                          "type": "block",
                          "size": {
                            "px": 0
                          },
                          "content": {
                            "mod": "homestead",
                            "props": {
                              "role": "blank"
                            }
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "status",
                  "type": "block",
                  "size": {
                    "px": 28
                  },
                  "content": {
                    "mod": "homestead",
                    "props": {
                      "role": "status"
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "theme": {
    "light": "graphite",
    "dark": "graphite"
  },
  "colors": {
    "chrome": "#101010",
    "canvas": "#101010",
    "background": "#161616",
    "surface": "#161616",
    "popover": "#1c1c1c",
    "raised": "#232323",
    "hover": "#1c1c1c",
    "selected": "#282828",
    "border": "#232323",
    "input": "#343434",
    "foreground": "#ffffff",
    "muted": "#a0a0a0",
    "dim": "#808080",
    "accent": "#ffc799",
    "accent_foreground": "#101010",
    "solid": "#ffc799",
    "solid_foreground": "#101010",
    "selection": "#343434",
    "cursor": "#ffc799",
    "working": "#a0a0a0",
    "blocked": "#ff8080",
    "done": "#99ffe4",
    "idle": "#808080",
    "unknown": "#505050",
    "ansi0": "#1c1c1c",
    "ansi1": "#ff8080",
    "ansi2": "#99ffe4",
    "ansi3": "#ffc799",
    "ansi4": "#97c1f7",
    "ansi5": "#dfa9da",
    "ansi6": "#8ddde7",
    "ansi7": "#a0a0a0",
    "ansi8": "#808080",
    "ansi9": "#ffa7a5",
    "ansi10": "#d9fff3",
    "ansi11": "#ffcfa8",
    "ansi12": "#b9d7ff",
    "ansi13": "#eec5ea",
    "ansi14": "#b6f1f8",
    "ansi15": "#ffffff"
  }
}
